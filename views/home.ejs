<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>
    <Style>
        body {
            font-family: 'Courier New', Courier, monospace;
        }
    </Style>
</head>

<body>
    <h1>URL Shortener</h1>

    <% if(locals.ids) { %>
        <p>The generated url was : http://localhost:3000/<%= ids %></p>
    <% } %>
    <div>
        <form method="post" action="/url">
            <label>Enter Original Url: </label>
            <input type="url" name="url" placeholder="https://example.com" required>
            <input type="submit" value="Generate">
        </form>
    </div>
    <div>
        <table>
            <thead>
                <th>S. No</th>
                <th>Shortid</th>
                <th>RedirectUrl</th>
                <th>Clicks</th>
            </thead>
            <tbody>
                <% if (locals.urls) { %>
                    <% urls.forEach((url, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= url.shortUrl %></td>
                            <td><%= url.redirectUrl %></td>
                            <td><%= url.clickHistory.length %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>